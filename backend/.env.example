# MySQL connection
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/booking_system

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed origins
# Include your GitHub Pages origin (no trailing slash, no path) alongside local dev:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-github-username.github.io
